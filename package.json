{
  "name": "signout",
  "version": "1.1.2",
  "description": "SignOut \u2014 NFC worker attendance PWA with rota, GPS geofence & Google Sheets sync",
  "main": "index.html",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "start": "npx serve .",
    "build": "node scripts/build-web.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify:apk": "node scripts/verify-apk-branding.mjs",
    "check:actions": "node scripts/check-action-runtimes.mjs",
    "release:check": "node scripts/release-check.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run build && npx cap sync && npx cap open android"
  },
  "keywords": [
    "pwa",
    "nfc",
    "attendance",
    "workforce",
    "geofence",
    "google-sheets",
    "capacitor",
    "offline-first"
  ],
  "author": "glainejustin <https://github.com/glainejustin> <glaine100justin@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  }
}
